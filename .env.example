# Copy this file to .env and fill in real values. Never commit .env to GitHub.
SUPABASE_URL=https://zyjgeqqegmjnjdufnjlh.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# SECRET key: keep server-side only. Never put it in the HTML file.
SUPABASE_SECRET_KEY=your_secret_key_here
SUPABASE_JWKS_URL=https://zyjgeqqegmjnjdufnjlh.supabase.co/auth/v1/.well-known/jwks.json

# Direct Postgres connection. Server-side only. Replace YOUR_PASSWORD with the database password
# (percent-encode special characters, e.g. @ becomes %40). Never use NEXT_PUBLIC_ for this.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.zyjgeqqegmjnjdufnjlh.supabase.co:5432/postgres
